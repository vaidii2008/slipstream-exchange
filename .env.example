PORT=3000
DATABASE_URL=postgres://slipstream:slipstream@127.0.0.1:5433/slipstream
REDIS_URL=redis://127.0.0.1:6380
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me
# One of fatal, error, warn, info, debug, trace, silent. Defaults to info.
LOG_LEVEL=info
# Orders one user may place per second before getting 429. Defaults to 20.
ORDER_RATE_LIMIT=20
# The trading terminal's origin; CORS lets only this origin call the API with cookies.
WEB_ORIGIN=http://localhost:3001
# The bot fleet (npm run bots): where the API is, and the password every bot account uses.
BOT_API_URL=http://localhost:3000
# At least 8 characters. Generate one with: openssl rand -base64 24
BOT_PASSWORD=change-me-too
