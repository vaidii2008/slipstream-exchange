{
  "name": "slipstream-exchange",
  "version": "0.1.0",
  "description": "A real-time centralized cryptocurrency exchange simulator",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node --env-file-if-exists=.env main.ts",
    "bots": "node --env-file-if-exists=.env fleet.ts",
    "test": "vitest run",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run check --prefix web",
    "bench": "node engine.bench.ts",
    "mcp": "node --env-file-if-exists=.env mcp.ts",
    "agent": "node --env-file-if-exists=.env agent.ts",
    "eval": "node --env-file-if-exists=.env evals.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.4.1",
    "@fastify/websocket": "^11.3.7",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@node-rs/argon2": "^2.2.1",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.7",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "redis": "^6.2.1",
    "zod": "^4.6.7"
  }
}
