{
  "name": "slipstream-exchange",
  "version": "0.1.0",
  "description": "A real-time centralized cryptocurrency exchange simulator",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
