    "format:check": "prettier --check .",
    "start": "node --env-file-if-exists=.env server.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "fastify": "^5.12.4",
    "zod": "^4.6.5"
  }
}
